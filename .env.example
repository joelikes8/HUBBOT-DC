# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here

# PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@host:port/database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=discord_bot_db

# Discord Role and Channel IDs
ADMIN_ROLE_ID=11111111111111111
STAFF_ROLE_ID=22222222222222222
ORDER_CHANNEL_ID=33333333333333333
ANNOUNCEMENT_CHANNEL_ID=44444444444444444

# Session Secret
SESSION_SECRET=change_this_to_something_secure

# Bot Invite URL
DISCORD_BOT_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=your_client_id&permissions=your_permissions&scope=bot
